{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bot-tasbit-howyat",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-02",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bot-tasbit-howyat-v2",
      "database_id": "4e3c0133-9004-4247-b19b-0b310387a0eb",
      "migrations_dir": "migrations"
    },
    {
      "binding": "LEGACY_DB",
      "database_name": "bot-tasbit-howyat-migration",
      "database_id": "f7a2d3ed-81f6-4e06-9e12-54507efd367b"
    }
  ],
  "vars": {
    "APP_NAME": "کمک‌یار مهاجر",
    "PAYMENT_FEE_PERCENT": "12",
    "RIALIT_API_BASE_URL": "https://api.rialit.io/api/v1",
    "RIALIT_WEBHOOK_IPS": "3.123.103.100"
  },
  "observability": {
    "enabled": true
  }
}
